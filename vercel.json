{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    { "src": "/",              "dest": "/index.html" },
    { "src": "/ngo",           "dest": "/ngo.html" },
    { "src": "/research",      "dest": "/research.html" },
    { "src": "/hospitality",   "dest": "/hospitality.html" },
    { "src": "/assets/(.*)",   "dest": "/assets/$1" },
    { "src": "/css/(.*)",      "dest": "/css/$1" },
    { "src": "/js/(.*)",       "dest": "/js/$1" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
